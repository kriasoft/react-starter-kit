{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema/index.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "generate": "bun --bun drizzle-kit generate",
    "migrate": "bun --bun drizzle-kit migrate",
    "migrate:staging": "ENVIRONMENT=staging bun --bun drizzle-kit migrate",
    "migrate:production": "ENVIRONMENT=production bun --bun drizzle-kit migrate",
    "push": "bun --bun drizzle-kit push",
    "studio": "bun --bun drizzle-kit studio",
    "studio:staging": "ENVIRONMENT=staging bun --bun drizzle-kit studio",
    "studio:production": "ENVIRONMENT=production bun --bun drizzle-kit studio",
    "seed": "bun scripts/seed.ts",
    "seed:staging": "ENVIRONMENT=staging bun scripts/seed.ts",
    "export": "bun scripts/export.ts",
    "export:staging": "ENVIRONMENT=staging bun scripts/export.ts",
    "export:production": "ENVIRONMENT=production bun scripts/export.ts",
    "introspect": "bun --bun drizzle-kit introspect",
    "up": "bun --bun drizzle-kit up",
    "check": "bun --bun drizzle-kit check",
    "drop": "bun --bun drizzle-kit drop",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "postgres": "^3.4.9"
  }
}
