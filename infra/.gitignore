.terraform/
.terraform.tfstate.lock.info

# State lives in HCP Terraform. A local copy only appears after a migration or
# a run with local execution – it holds the database password, so never commit it.
*.tfstate
*.tfstate.*

# Only needed with local execution; values normally live in the workspace.
*.tfvars
*.tfvars.json

# Saved plans from `terraform plan -out`. Against HCP these are a thin reference
# to the remote run, but local execution writes the real plan, variables included.
tfplan
*.tfplan
plan.txt

crash.log
crash.*.log
