{
  "name": "@repo/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "db",
    "packages/*",
    "scripts"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter @repo/web --filter @repo/api --filter @repo/app dev",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun --bun vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --build",
    "build": "bun --filter @repo/email --filter @repo/web --filter @repo/api --filter @repo/app build",
    "deploy:staging": "bun scripts/deploy.ts staging",
    "deploy:production": "bun scripts/deploy.ts production",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "bun run docs:build && gh-pages --dist docs/.vitepress/dist",
    "app:dev": "bun --cwd apps/app dev",
    "app:build": "bun --cwd apps/app build",
    "app:test": "bun --cwd apps/app test",
    "app:deploy": "bun --cwd apps/app deploy",
    "web:dev": "bun --cwd apps/web dev",
    "web:build": "bun --cwd apps/web build",
    "web:check": "bun --cwd apps/web check",
    "web:deploy": "bun --cwd apps/web deploy",
    "api:dev": "bun --cwd apps/api dev",
    "api:build": "bun --cwd apps/api build",
    "api:build:docker": "docker build --tag api:latest -f ./apps/api/Dockerfile .",
    "api:test": "bun --cwd apps/api test",
    "api:deploy": "bun --cwd apps/api deploy",
    "ui:add": "bun --cwd packages/ui add",
    "ui:update": "bun --cwd packages/ui update",
    "email:dev": "bun --cwd apps/email dev",
    "email:build": "bun --cwd apps/email build",
    "email:export": "bun --cwd apps/email export",
    "db:generate": "bun --cwd db generate",
    "db:migrate": "bun --cwd db migrate",
    "db:migrate:staging": "bun --cwd db migrate:staging",
    "db:migrate:production": "bun --cwd db migrate:production",
    "db:push": "bun --cwd db push",
    "db:studio": "bun --cwd db studio",
    "db:studio:staging": "bun --cwd db studio:staging",
    "db:studio:production": "bun --cwd db studio:production",
    "db:seed": "bun --cwd db seed",
    "db:seed:staging": "bun --cwd db seed:staging",
    "db:export": "bun --cwd db export",
    "db:export:staging": "bun --cwd db export:staging",
    "db:export:production": "bun --cwd db export:production",
    "db:check": "bun --cwd db check",
    "db:typecheck": "bun --cwd db typecheck",
    "infra:check": "terraform fmt -check -recursive infra/ && for root in infra/envs/*/; do test -f \"$root/.terraform.lock.hcl\" && terraform -chdir=\"$root\" init -backend=false -input=false -lockfile=readonly && terraform -chdir=\"$root\" validate || exit 1; done",
    "infra:staging": "terraform -chdir=infra/envs/staging",
    "infra:production": "terraform -chdir=infra/envs/production"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~5.0.0",
    "@ws-kit/zod": "^0.10.2",
    "gh-pages": "^6.3.0",
    "graphql": "^17.0.2",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mermaid": "^11.17.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "react": "^19.3.0",
    "srcpack": "^0.3.0",
    "typescript": "~7.0.2",
    "vite": "~8.3.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "~5.0.0",
    "wrangler": "^4.131.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,astro}": "bunx oxlint --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern",
    "*": "bunx oxfmt --check --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
