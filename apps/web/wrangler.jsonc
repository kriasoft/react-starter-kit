{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // [METADATA]
  // Edge router that receives all traffic and routes to api/app via service bindings.
  "name": "example-web",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "observability": { "enabled": true },

  // [ASSETS]
  // Serves bundled JavaScript, CSS, images, and other static assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Force worker execution for "/" to enable auth-aware routing
    // See docs/adr/001-auth-hint-cookie.md
    "run_worker_first": ["/"]
  },

  // [SERVICE BINDINGS]
  // Connect to other workers for dynamic routing.
  // NOTE: services is non-inheritable – must be specified per environment.
  // Use naming convention: <worker>-<env> (e.g., example-app-staging)
  "services": [
    { "binding": "APP_SERVICE", "service": "example-app" },
    { "binding": "API_SERVICE", "service": "example-api" }
  ],

  // [ENV:PRODUCTION]
  // Command: bun wrangler deploy --env=""
  //
  // Custom domain: this worker is the origin for the whole hostname, so Wrangler
  // creates the DNS record and certificate and Terraform owns no DNS at all.
  // The pattern must be a bare hostname – no "/*", no zone_name.
  // prettier-ignore
  "routes": [
    { "pattern": "example.com", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },

  "env": {
    // [ENV:DEVELOPMENT]
    // Named Wrangler development environment; `bun dev` uses Astro instead.
    "dev": {
      "services": [
        { "binding": "APP_SERVICE", "service": "example-app-dev" },
        { "binding": "API_SERVICE", "service": "example-api-dev" }
      ],
      "vars": {
        "ENVIRONMENT": "development"
      }
    },

    // [ENV:STAGING]
    // Command: bun wrangler deploy --env staging
    "staging": {
      "services": [
        { "binding": "APP_SERVICE", "service": "example-app-staging" },
        { "binding": "API_SERVICE", "service": "example-api-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging"
      },
      // prettier-ignore
      "routes": [
        { "pattern": "staging.example.com", "custom_domain": true }
      ]
    }
  }
}
