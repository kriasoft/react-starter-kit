# Shared environment defaults committed to git (no real secrets).
# Put real credentials in `.env.local` (git-ignored), which overrides `.env`.
# https://vite.dev/guide/env-and-mode#env-files

# Web application settings
APP_NAME=Example
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
ENVIRONMENT=development
PORT=8787

# Database
# https://get.neon.com/HD157BR (referral – helps support this project)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/example

# Cloudflare Hyperdrive for local development
# https://developers.cloudflare.com/hyperdrive/
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED=postgres://postgres:postgres@localhost:5432/example
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_UNCACHED=postgres://postgres:postgres@localhost:5432/example

# Better Auth
# bunx auth@latest secret
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth 2.0 (optional – email OTP and passkeys work without it)
# https://console.cloud.google.com/apis/credentials
# Left unset so absence means disabled. A placeholder here is truthy, which
# would enable Google with credentials that cannot work. Set both or neither.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx

# Cloudflare
# https://dash.cloudflare.com/
# https://developers.cloudflare.com/api/tokens/create
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend
# https://resend.com/api-keys
RESEND_API_KEY=xxxxx
RESEND_EMAIL_FROM=onboarding@resend.dev

# Stripe Billing (optional – app works without these, billing features disabled)
# https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_STARTER_PRICE_ID=price_xxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxx
# STRIPE_PRO_ANNUAL_PRICE_ID=price_xxxxx
